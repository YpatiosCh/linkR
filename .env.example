# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Port 5433 matches the docker-compose service.
DATABASE_URL="postgres://app:app@localhost:5433/digital_delivery?sslmode=disable"

# ── Authentication ────────────────────────────────────────────────────────────
# HS256 signing secret for JWT access tokens. Must be at least 32 random bytes.
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-before-deploying-use-at-least-32-random-bytes"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key used to send transactional emails (verification, password reset).
# Create one at https://resend.com/api-keys. Required — the server fails to
# start without it.
RESEND_API_KEY=""

# Sender identity for outgoing emails, in "Name <address>" form. The address's
# domain must be a verified sending domain in your Resend account.
EMAIL_FROM="linkMe <noreply@linkme.app>"

# Base URL of the frontend app. Used to build the verification/reset links
# embedded in emails (e.g. FRONTEND_URL + "/verify-email?token=...").
FRONTEND_URL="http://localhost:3000"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. The server echoes the matching origin
# back (never *) and sets credentials=true. Add your Next.js dev URL here;
# for production add your real domain.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ── Environment ───────────────────────────────────────────────────────────────
# Controls environment-specific behaviour (e.g. HSTS is only set in production).
# Values: development | production
APP_ENV="development"
