# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Port 5433 matches the docker-compose service.
DATABASE_URL="postgres://app:app@localhost:5433/digital_delivery?sslmode=disable"

# ── Authentication ────────────────────────────────────────────────────────────
# HS256 signing secret for JWT access tokens. Must be at least 32 random bytes.
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-before-deploying-use-at-least-32-random-bytes"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. The server echoes the matching origin
# back (never *) and sets credentials=true. Add your Next.js dev URL here;
# for production add your real domain.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ── Environment ───────────────────────────────────────────────────────────────
# Controls environment-specific behaviour (e.g. HSTS is only set in production).
# Values: development | production
APP_ENV="development"
