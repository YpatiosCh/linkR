# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Port 5433 matches the docker-compose service.
DATABASE_URL="postgres://app:app@localhost:5433/digital_delivery?sslmode=disable"

# ── Authentication ────────────────────────────────────────────────────────────
# HS256 signing secret for JWT access tokens. Must be at least 32 random bytes.
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-before-deploying-use-at-least-32-random-bytes"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Resend API key used to send transactional emails (verification, password reset).
# Create one at https://resend.com/api-keys. Required — the server fails to
# start without it.
RESEND_API_KEY=""

# Sender identity for outgoing emails, in "Name <address>" form. The address's
# domain must be a verified sending domain in your Resend account.
EMAIL_FROM="linkMe <noreply@linkme.app>"

# Base URL of the frontend app. Used to build the verification/reset links
# embedded in emails (e.g. FRONTEND_URL + "/verify-email?token=...").
FRONTEND_URL="http://localhost:3000"

# ── Authentication (Google OAuth) ────────────────────────────────────────────
# Google OAuth 2.0 client credentials, from a Google Cloud Console project's
# "OAuth 2.0 Client IDs" (APIs & Services > Credentials). Required — the
# server fails to start without them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must exactly match one of the "Authorized redirect URIs" configured for the
# OAuth client above (e.g. http://localhost:8080/api/v1/auth/google/callback
# in development). No default — a silently wrong value is a security risk.
GOOGLE_REDIRECT_URL=""

# ── Redis ─────────────────────────────────────────────────────────────────────
# Shared state backend: session revocation (immediate logout) and rate
# limiting, both shared across every server instance. Port 6380 matches the
# docker-compose service (offset from the default 6379 in case a system
# Redis is already running).
REDIS_ADDR="localhost:6380"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. The server echoes the matching origin
# back (never *) and sets credentials=true. Add your Next.js dev URL here;
# for production add your real domain.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ── Environment ───────────────────────────────────────────────────────────────
# Controls environment-specific behaviour (e.g. HSTS is only set in production).
# Values: development | production
APP_ENV="development"

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum level emitted by the structured logger. Log format follows APP_ENV:
# JSON in production, human-readable text otherwise.
# Values: debug | info | warn | error
LOG_LEVEL="info"
